# Several packages here still declare peer ranges against React 17 while the app
# runs React 18. npm 7+ treats that as a hard install failure, so a plain
# `npm install` on a fresh clone dies with ERESOLVE before anything is fetched.
# Recording the flag here means clone-and-install works without callers having to
# know the incantation, and CI resolves the tree the same way a developer does.
legacy-peer-deps=true
